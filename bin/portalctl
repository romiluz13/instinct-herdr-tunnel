#!/usr/bin/env node
'use strict';
const { execFileSync, spawnSync, spawn } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const http = require('http');
const net = require('net');
const { config, ensureDirs } = require('../lib/config');
const { createToken } = require('../lib/security');
const { HISTORY, CONTROL, AGENT_CLICK, TAG_PANES, capabilities } = require('../lib/gates');
const diagnose = require('../lib/diagnose');

const ROOT = path.join(__dirname, '..');
const UID = process.getuid();
const DOMAIN = `gui/${UID}`;
const PREFIX = process.env.HERDR_PORTAL_LAUNCHD_PREFIX || 'dev.herdr-portal'; // launchd label of the portal; the tunnel adds ".tunnel"
if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$/.test(PREFIX)) { console.error('error: HERDR_PORTAL_LAUNCHD_PREFIX may contain only letters, digits, ".", "_" and "-"'); process.exit(2); }
const LABELS = { portal: PREFIX, tunnel: PREFIX + '.tunnel' };
const plistPath = (k) => path.join(os.homedir(), 'Library', 'LaunchAgents', LABELS[k] + '.plist');
const which = (b) => { try { return execFileSync('/usr/bin/which', [b], { encoding: 'utf8' }).trim(); } catch { return null; } };
const LAUNCHCTL = process.env.HERDR_PORTAL_LAUNCHCTL || '/bin/launchctl'; // the override exists so tests can run `install` against a fake launchctl
const LSOF = process.env.HERDR_PORTAL_LSOF || '/usr/sbin/lsof'; // likewise, so a test can stand in for a listener owned by another user
const lc = (...a) => spawnSync(LAUNCHCTL, a, { encoding: 'utf8' });
// `cloudflared service install` runs as a LaunchAgent (gui/<uid>), and with sudo as a LaunchDaemon (system): both outside this tool.
const cloudflaredService = () => ['system', `gui/${process.getuid()}`].map((d) => lc('print', `${d}/com.cloudflare.cloudflared`)).find((r) => r.status === 0) || null;
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');

// launchd gives services this minimal PATH; the plist records it and the install preflight runs herdr under it.
const SERVICE_PATH = '/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin';
// The switches for history, scroll, click and pane tags reach the portal service only with a value it understands; anything else would leave
// the capability off in the service while the installer believed it on.
const SWITCH_VALUES = { [HISTORY]: ['1', 'agents', 'all'], [CONTROL]: ['1'], [AGENT_CLICK]: ['1'], [TAG_PANES]: ['1'] };
const installSwitches = () => Object.fromEntries(Object.entries(SWITCH_VALUES).filter(([k, ok]) => ok.includes(process.env[k])).map(([k]) => [k, process.env[k]]));
const droppedSwitches = () => Object.keys(SWITCH_VALUES).filter((k) => !['', '0', undefined].includes(process.env[k]) && !SWITCH_VALUES[k].includes(process.env[k]));
const PASS_THROUGH = ['HERDR_PORTAL_STATE_DIR', 'HERDR_PORTAL_LOG_DIR', 'HERDR_PORTAL_HOSTS', 'HERDR_PORTAL_TUNNEL_METRICS', 'CLOUDFLARED_BIN', 'HERDR_PORTAL_DROP_DIR'];

function plist(kind) {
  const logBase = path.join(config.logDir, kind === 'portal' ? 'portal' : 'tunnel');
  const nodeBin = process.execPath;
  const script = kind === 'portal' ? path.join(ROOT, 'server.js') : path.join(ROOT, 'bin', 'tunnel-runner.js');
  const env = { PATH: SERVICE_PATH, HOME: os.homedir(), HERDR_BIN: herdrBin(), HERDR_PORTAL_PORT: String(config.port) };
  // A service that ignored a non-default location chosen at install time would read another token and ledger than portalctl does.
  for (const k of PASS_THROUGH) if (process.env[k]) env[k] = process.env[k];
  // Each opt-in reaches the service only when the installer set it to exactly "1", and only the portal reads them.
  for (const k of ['HERDR_PORTAL_ENABLE_AGENT_DECISION', 'HERDR_PORTAL_STRICT_VERSION']) if (kind === 'portal' && process.env[k] === '1') env[k] = '1';
  if (kind === 'portal') Object.assign(env, installSwitches());
  const envXml = Object.entries(env).map(([k, v]) => `    <key>${k}</key><string>${esc(v)}</string>`).join('\n');
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${LABELS[kind]}</string>
  <key>ProgramArguments</key><array><string>${esc(nodeBin)}</string><string>${esc(script)}</string></array>
  <key>WorkingDirectory</key><string>${esc(ROOT)}</string>
  <key>EnvironmentVariables</key><dict>
${envXml}
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>${esc(logBase)}.log</string>
  <key>StandardErrorPath</key><string>${esc(logBase)}.err.log</string>
</dict></plist>
`;
}

// launchd gives services a minimal PATH, so the plist records an absolute path. If `herdr` is a version-manager shim, set HERDR_BIN to the real binary.
function herdrBin() { return process.env.HERDR_BIN || which('herdr') || config.herdrBin; }

const portFree = (port) => new Promise((resolve) => {
  const probe = net.createServer(); probe.once('error', () => resolve(false));
  probe.listen(port, config.host, () => probe.close(() => resolve(true)));
});
const isExecutable = (f) => { try { fs.accessSync(f, fs.constants.X_OK); return fs.statSync(f).isFile(); } catch { return false; } };

// Everything `install` depends on is checked BEFORE it writes a token, directory, plist or launchd job.
async function preflight() {
  const problems = [];
  const hb = herdrBin();
  if (!path.isAbsolute(hb)) problems.push(`herdr resolved to "${hb}", which is not an absolute path, and launchd starts services with a minimal PATH. Install Herdr or set HERDR_BIN to its real binary (not a version-manager shim).`);
  else if (!isExecutable(hb)) problems.push(`herdr at ${hb} is not an executable file. Set HERDR_BIN to the real binary.`);
  else {
    const v = spawnSync(hb, ['--version'], { env: { PATH: SERVICE_PATH, HOME: os.homedir() }, encoding: 'utf8', timeout: 5000 });
    if (v.status !== 0) problems.push(`${hb} --version failed under launchd's minimal environment (exit ${v.status === null ? 'timeout/signal' : v.status}). If it is a version-manager shim, set HERDR_BIN to the real binary.`);
  }
  // A job that is already loaded under this label legitimately holds the port during a reinstall.
  if (!loaded('portal') && !(await portFree(config.port))) problems.push(`${config.host}:${config.port} is already in use. Another portal (for example one installed under a different launchd label) may share this port, token and ledger. Choose a fresh instance: set HERDR_PORTAL_PORT, HERDR_PORTAL_STATE_DIR and HERDR_PORTAL_LOG_DIR. Migrating an existing instance is a separate step you do yourself; install never renames, copies or rotates existing state.`);
  const cf = process.env.CLOUDFLARED_BIN || which('cloudflared');
  return { problems, tunnel: !!cf && path.isAbsolute(cf) && isExecutable(cf) };
}

const loaded = (k) => lc('print', `${DOMAIN}/${LABELS[k]}`).status === 0;
const kinds = (arg) => (arg === 'portal' || arg === 'tunnel' ? [arg] : ['portal', 'tunnel']);

function start(k) {
  if (!fs.existsSync(plistPath(k))) throw new Error('not installed; run: portalctl install');
  if (loaded(k)) { lc('kickstart', `${DOMAIN}/${LABELS[k]}`); return 'already loaded; kickstarted'; }
  lc('enable', `${DOMAIN}/${LABELS[k]}`);
  const r = lc('bootstrap', DOMAIN, plistPath(k));
  if (r.status !== 0) throw new Error(`bootstrap ${k} failed: ${r.stderr.trim()}`);
  return 'started';
}
const stop = (k) => { if (!loaded(k)) return 'not loaded'; const r = lc('bootout', `${DOMAIN}/${LABELS[k]}`); if (r.status !== 0) throw new Error(`bootout ${k}: ${r.stderr.trim()}`); return 'stopped'; };
const restart = (k) => { if (!loaded(k)) return start(k); const r = lc('kickstart', '-k', `${DOMAIN}/${LABELS[k]}`); if (r.status !== 0) throw new Error(`kickstart ${k}: ${r.stderr.trim()}`); return 'restarted'; };

function get(p, headers = {}) {
  return new Promise((resolve) => {
    const r = http.get({ host: config.host, port: config.port, path: p, headers, timeout: 3000 }, (res) => { let b = ''; res.on('data', (c) => (b += c)); res.on('end', () => { let j = null; try { j = JSON.parse(b); } catch { /* */ } resolve({ status: res.statusCode, json: j }); }); });
    r.on('error', (e) => resolve({ status: 0, error: e.code })); r.on('timeout', () => { r.destroy(); resolve({ status: 0, error: 'timeout' }); });
  });
}
const token = () => fs.readFileSync(config.tokenFile, 'utf8').trim();

function copyToken() {
  const t = token();
  const pb = spawnSync('/usr/bin/pbcopy', { input: t });
  if (pb.status !== 0) throw new Error('pbcopy failed');
  const digest = crypto.createHash('sha256').update(t).digest('hex');
  // clear the clipboard after 60s, only if it still holds the token
  const code = `setTimeout(()=>{const{execFileSync,spawnSync}=require('child_process');const c=require('crypto');try{const cur=execFileSync('/usr/bin/pbpaste',{encoding:'utf8'}).trim();if(c.createHash('sha256').update(cur).digest('hex')==='${digest}')spawnSync('/usr/bin/pbcopy',{input:''});}catch{}},60000)`;
  spawn(process.execPath, ['-e', code], { detached: true, stdio: 'ignore' }).unref();
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// The token goes only to a listener on the port that runs as this user. Right after a bootout the port is free, and any
// local user who binds it first would otherwise receive the token and could answer the health check.
function listenerOwned() {
  const r = spawnSync(LSOF, ['-nP', `-iTCP@${config.host}:${config.port}`, '-sTCP:LISTEN', '-a', '-Fu'], { encoding: 'utf8', timeout: 5000 });
  const uids = r.status === 0 ? (r.stdout || '').split('\n').filter((l) => /^u\d+$/.test(l)).map((l) => Number(l.slice(1))) : [];
  if (!uids.length) return 'could not confirm who listens on the port';
  return uids.every((u) => u === UID) ? null : 'the listener on the port is not owned by this user';
}

// The running portal's build identity, or null when it does not answer an authenticated /api/health.
let refusedOwner = null;
async function served() {
  let t; try { t = token(); } catch { return null; }
  refusedOwner = listenerOwned(); // only the last poll's refusal explains a failed verification
  if (refusedOwner) return null;
  const h = await get('/api/health', { Authorization: 'Bearer ' + t });
  return h.status === 200 && h.json && h.json.build ? { ...h.json.build, capabilities: h.json.capabilities } : null;
}

// A loaded job keeps the definition it was loaded with: kickstart restarts the same job and never rereads the plist.
// So a reinstall boots the old job out, waits until launchd no longer has it, and only then writes the new plist.
async function unload(k) {
  const r = lc('bootout', `${DOMAIN}/${LABELS[k]}`);
  if (r.status !== 0) throw new Error(`bootout ${k} failed (${(r.stderr || '').trim() || 'exit ' + r.status}); the old definition is still loaded and its plist was not rewritten`);
  for (let i = 0; i < 40 && loaded(k); i++) await sleep(250);
  if (loaded(k)) throw new Error(`${k} is still loaded 10 s after bootout; its plist was not rewritten`);
}

// The installed definition is in effect only when a NEW portal process answers with the flags this install asked for.
async function verifyPortal(before) {
  const want = { strict_version: process.env.HERDR_PORTAL_STRICT_VERSION === '1', agent_decision: process.env.HERDR_PORTAL_ENABLE_AGENT_DECISION === '1' };
  let b = null;
  for (let i = 0; i < 40; i++) {
    b = await served();
    if (b && b.instance_id && (!before || b.instance_id !== before.instance_id)) break;
    b = null; await sleep(250);
  }
  if (!b) throw new Error(`no new portal instance answered /api/health within 10 s${refusedOwner ? ` (the last check did not send the token: ${refusedOwner})` : before ? ' (the old instance may still be answering)' : ''}; the new definition is not proven in effect`);
  const got = { strict_version: !!(b.flags && b.flags.strict_version), agent_decision: !!(b.flags && b.flags.agent_decision) };
  if (got.strict_version !== want.strict_version || got.agent_decision !== want.agent_decision) throw new Error(`the new portal instance reports flags ${JSON.stringify(got)} but this install set ${JSON.stringify(want)}`);
  const wantCaps = capabilities(installSwitches()); const gotCaps = b.capabilities || {};
  if (['history', 'control', 'agent_click', 'tag_panes'].some((k) => gotCaps[k] !== wantCaps[k])) throw new Error(`the new portal instance reports capabilities ${JSON.stringify(gotCaps)} but this install set ${JSON.stringify(wantCaps)}`);
  return `new instance ${b.instance_id.slice(0, 8)} started ${b.started_at}, flags ${JSON.stringify(got)}, capabilities ${JSON.stringify(wantCaps)}`;
}

const cmds = {
  async plist(a) { if (!LABELS[a]) { console.error('usage: portalctl plist <portal|tunnel>'); process.exit(2); } process.stdout.write(plist(a)); },
  async install() {
    const pre = await preflight();
    if (pre.problems.length) { for (const m of pre.problems) console.error('preflight: ' + m); console.error('nothing was written and no service was started'); process.exit(1); }
    for (const k of droppedSwitches()) console.error(`warning: ${k}=${String(process.env[k]).slice(0, 20)} is not a value the portal accepts (${SWITCH_VALUES[k].join(', ')}); the service will not get it`);
    const kindsToInstall = pre.tunnel ? ['portal', 'tunnel'] : ['portal'];
    if (!pre.tunnel) console.log('cloudflared not found (set CLOUDFLARED_BIN to an absolute path to use a tunnel): installing the portal only');
    ensureDirs();
    if (!fs.existsSync(config.tokenFile)) { const n = createToken(); console.log(`token created (${n} chars, mode 0600) at ${config.tokenFile}`); }
    fs.mkdirSync(path.dirname(plistPath('portal')), { recursive: true });
    const was = Object.fromEntries(kindsToInstall.map((k) => [k, loaded(k)]));
    const before = was.portal ? await served() : null;
    for (const k of kindsToInstall) {
      if (was[k]) { await unload(k); console.log(`${k} booted out (was loaded)`); }
      fs.writeFileSync(plistPath(k), plist(k), { mode: 0o644 }); console.log(`wrote ${plistPath(k)}`);
      try { console.log(k, start(k)); } catch (e) { throw new Error(`${e.message}; ${k} is not running${was[k] ? ' (the old job was booted out)' : ''}`); }
    }
    if (was.portal) console.log('portal', await verifyPortal(before));
  },
  async start(a) { for (const k of kinds(a)) console.log(k, start(k)); },
  async stop(a) { for (const k of kinds(a)) console.log(k, stop(k)); },
  async restart(a) { for (const k of kinds(a)) console.log(k, restart(k)); },
  async status() {
    for (const k of ['portal', 'tunnel']) {
      const r = lc('print', `${DOMAIN}/${LABELS[k]}`);
      const pid = /\bpid = (\d+)/.exec(r.stdout || '')?.[1];
      const state = /\bstate = (\w[\w ]*)/.exec(r.stdout || '')?.[1];
      console.log(`${k.padEnd(7)} launchd: ${r.status === 0 ? `loaded, state=${state}, pid=${pid || '-'}` : 'not loaded'}`);
    }
    const ext = cloudflaredService();
    if (ext) console.log(`daemon  com.cloudflare.cloudflared: loaded, state=${/\bstate = (\w[\w ]*)/.exec(ext.stdout || '')?.[1]}, pid=${/\bpid = (\d+)/.exec(ext.stdout || '')?.[1] || '-'}`);
    const hz = await get('/healthz');
    console.log(`portal  http://${config.host}:${config.port}/healthz -> ${hz.status || hz.error}`);
    const why = listenerOwned();
    if (why) console.log(`health  token not sent: ${why}`);
    else try {
      const h = await get('/api/health', { Authorization: 'Bearer ' + token() });
      if (h.json) {
        console.log(`tunnel  up=${h.json.tunnel.up} (${h.json.tunnel.probe})`);
        console.log(`herdr   sessions reachable ${h.json.herdr.reachable_sessions}/${h.json.herdr.total_sessions}, installed ${h.json.herdr.installed_version}, writes ${h.json.herdr.writes_enabled ? 'enabled' : 'DISABLED: ' + h.json.herdr.writes_disabled_reason}`);
        console.log(`data    stale=${h.json.data.stale} worst_age_ms=${h.json.data.worst_age_ms}`);
      } else console.log(`health  api/health -> ${h.status || h.error}`);
    } catch (e) { console.log('health  token file unreadable: ' + e.code); }
    await cmds.url();
  },
  async diagnose() {
    const r = lc('print', `${DOMAIN}/${LABELS.portal}`);
    const launchd = { loaded: r.status === 0, pid: /\bpid = (\d+)/.exec(r.stdout || '')?.[1] || null };
    console.log(diagnose.render(await diagnose.collect({ config, launchd })).join('\n'));
  },
  async url() {
    let u = null; try { u = fs.readFileSync(config.tunnelUrlFile, 'utf8').trim(); } catch { /* none */ }
    let named = false; let host = null;
    try { const t = JSON.parse(fs.readFileSync(path.join(config.stateDir, 'tunnel.json'), 'utf8')); named = t.mode === 'named'; host = named && typeof t.hostname === 'string' ? t.hostname : null; } catch { /* quick */ }
    if (!u && host && cloudflaredService()) u = `https://${host}`; // named tunnel run by the cloudflared service, not by tunnel-runner.js
    console.log(u ? `public url: ${u}  (${named ? 'named tunnel, persistent' : 'QUICK TUNNEL: changes every restart, no uptime guarantee'})` : 'public url: none (tunnel not running or URL not yet issued)');
  },
  async logs(a) { const k = a === 'tunnel' ? 'tunnel' : 'portal'; spawnSync('/usr/bin/tail', ['-n', '40', path.join(config.logDir, `${k}.log`), path.join(config.logDir, `${k}.err.log`)], { stdio: 'inherit' }); },
  async 'token-copy'() { copyToken(); console.log('token copied to clipboard (not printed); clipboard is cleared in 60s if unchanged. Paste it into the portal login or your password manager.'); },
  async 'rotate-token'(a) {
    const n = createToken(); console.log(`new token created (${n} chars); old token is invalid after the portal restarts`);
    console.log('portal', restart('portal'));
    if (a === '--copy') { await sleep(500); copyToken(); console.log('new token copied to clipboard (cleared in 60s)'); }
  },
  async revoke() {
    console.log('tunnel', stop('tunnel'));
    createToken(); console.log('portal', loaded('portal') ? restart('portal') : 'not loaded (token replaced on disk)');
    console.log('access revoked: tunnel stopped and token replaced. Run `portalctl start tunnel` and `portalctl token-copy` to restore.');
  },
  async uninstall() { for (const k of ['tunnel', 'portal']) { console.log(k, stop(k)); fs.rmSync(plistPath(k), { force: true }); } console.log('plists removed; state, logs and token kept'); },
};

const [cmd, arg] = process.argv.slice(2);
if (!cmds[cmd]) { console.log('usage: portalctl <install|plist|start|stop|restart|status|diagnose|url|logs|token-copy|rotate-token|revoke|uninstall> [portal|tunnel|--copy]'); process.exit(cmd ? 2 : 0); }
cmds[cmd](arg).catch((e) => { console.error('error:', e.message); process.exit(1); });
